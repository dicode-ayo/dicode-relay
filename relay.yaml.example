# dicode-relay configuration
#
# Copy to relay.yaml and adjust for your environment.
# String values support ${ENV_VAR} interpolation — resolved at startup.
# Providers whose client_id resolves to empty are silently skipped.
#
# Config path: relay.yaml (default), --config <path>, or RELAY_CONFIG env.

server:
  # Public listener: webhooks (/u/<uuid>/hooks/*), OAuth routes, /status.
  # Plain HTTP or one-cert TLS — fine behind a TLS-terminating proxy
  # (Cloudflare, nginx).
  port: 5553
  base_url: http://localhost:5553

  # Declare a multi-instance deployment (2+ relay instances behind a load
  # balancer sharing one public identity). Default false = single instance,
  # where the broker signing key and mTLS server cert auto-generate on first
  # start. Set true and ALL instances become fail-fast until you supply
  # identical shared material to every instance: broker.signing_key_file plus
  # server.mtls.cert_file/key_file (or a shared server.tls cert). Without it,
  # each instance mints its own key/cert and daemons reject token deliveries
  # and cert pins from every instance but one. See docs/scaling.md.
  multi_instance: false

  tls:
    cert_file: ""          # e.g. ${TLS_CERT_FILE}
    key_file: ""           # e.g. ${TLS_KEY_FILE}

  # mTLS control channel: the port daemons dial (wss://). Always TLS with
  # client certificates requested — the peer certificate carries the daemon
  # identity. This port needs END-TO-END TLS passthrough: expose it directly
  # or via an L4 (TCP) load balancer only. A TLS-terminating proxy in front
  # of it (Cloudflare orange-cloud, nginx TLS termination) strips the client
  # certificate and breaks every daemon connection.
  #
  # cert_file/key_file empty → falls back to server.tls.*; if that is also
  # empty, a self-signed dev cert is auto-generated at cwd/relay-mtls-cert.pem
  # (point daemons' relay.ca_file at it). The auto-generate path is
  # single-instance only — with server.multi_instance: true it becomes a
  # startup error, since each instance would otherwise pin a different cert.
  mtls:
    port: 5554
    cert_file: ""          # e.g. ${MTLS_CERT_FILE}
    key_file: ""           # e.g. ${MTLS_KEY_FILE}

# status:
#   # Uncomment and set STATUS_PASSWORD in the environment to enable the
#   # password-protected /status dashboard (basic auth, password-only — the
#   # username is ignored). Leaving the entire section commented out, or
#   # omitting `password`, makes /status and /api/status return 404
#   # ("status page not configured"). An empty value is rejected at load
#   # time so a typo'd STATUS_PASSWORD never silently exposes the dashboard.
#   password: ${STATUS_PASSWORD}

relay:
  # Clock-skew tolerance for OAuth /auth request freshness.
  timestamp_tolerance_s: 30
  ping_interval_ms: 30000
  pong_timeout_ms: 10000
  request_timeout_ms: 30000

  # Availability guards on the webhook forward path (DoS/backpressure).
  # Defaults carry generous headroom over any single daemon's realistic load,
  # so a well-behaved daemon never trips them.
  #
  # Max outstanding forwards to one daemon before new inbound requests get 429
  # (instead of growing the pending map without bound under a slow daemon).
  max_pending_per_client: 256
  # WS send-buffer high-water mark in bytes. When a daemon socket's
  # bufferedAmount is above this, new forwards get 503 rather than queueing onto
  # a socket that is not draining. Kept above one max body (below).
  max_buffered_bytes: 16777216   # 16 MiB
  # Max inbound webhook body in bytes; larger requests are rejected by the
  # public listener before they reach the daemon.
  max_body_bytes: 5242880        # 5 MiB

broker:
  session_ttl_ms: 300000

  # Broker signing-key file. Precedence: env BROKER_SIGNING_KEY_FILE >
  # env BROKER_SIGNING_KEY (inline PEM) > this field > auto-generate.
  # Use a literal path — do NOT use `${ENV_VAR}` interpolation here. If
  # the env var is unset, interpolation silently collapses to "", skips
  # this field, and auto-generates a fresh key on every start, rotating
  # the broker's public key and invalidating delivery signatures for
  # daemons that have not reconnected since. Either write the absolute
  # path literally, or set the env var. Required (identical across instances)
  # when server.multi_instance: true — auto-generate is refused in that mode.
  signing_key_file: ""     # empty → auto-generate at cwd/broker-signing-key.pem

  # OAuth providers — add your own or override defaults.
  # Each key is the Grant provider key and the dicode provider name.
  providers:
    github:
      client_id: ${GITHUB_CLIENT_ID}
      client_secret: ${GITHUB_CLIENT_SECRET}
      pkce: true
      scopes: [user, repo]

    slack:
      client_id: ${SLACK_CLIENT_ID}
      pkce: true
      scopes: [channels:read]

    google:
      client_id: ${GOOGLE_CLIENT_ID}
      client_secret: ${GOOGLE_CLIENT_SECRET}
      pkce: true
      scopes: ["https://www.googleapis.com/auth/userinfo.email"]

    spotify:
      client_id: ${SPOTIFY_CLIENT_ID}
      pkce: true
      scopes: [user-read-private, user-read-email]

    linear:
      client_id: ${LINEAR_CLIENT_ID}
      pkce: true
      scopes: [read]

    discord:
      client_id: ${DISCORD_CLIENT_ID}
      pkce: true
      scopes: [identify, email]

    gitlab:
      client_id: ${GITLAB_CLIENT_ID}
      client_secret: ${GITLAB_CLIENT_SECRET}
      pkce: true
      scopes: [read_user, read_api]

    airtable:
      client_id: ${AIRTABLE_CLIENT_ID}
      client_secret: ${AIRTABLE_CLIENT_SECRET}
      pkce: true
      scopes: ["data.records:read"]

    notion:
      client_id: ${NOTION_CLIENT_ID}
      client_secret: ${NOTION_CLIENT_SECRET}
      pkce: false
      scopes: []

    confluence:
      client_id: ${CONFLUENCE_CLIENT_ID}
      pkce: true
      scopes: ["read:me", "read:confluence-content.all", offline_access]

    salesforce:
      client_id: ${SALESFORCE_CLIENT_ID}
      pkce: true
      scopes: [api, refresh_token]

    stripe:
      client_id: ${STRIPE_CLIENT_ID}
      client_secret: ${STRIPE_CLIENT_SECRET}
      pkce: false
      scopes: [read_write]

    office365:
      client_id: ${OFFICE365_CLIENT_ID}
      client_secret: ${OFFICE365_CLIENT_SECRET}
      pkce: true
      scopes: [offline_access, User.Read, Mail.Read]

    azure:
      client_id: ${AZURE_CLIENT_ID}
      client_secret: ${AZURE_CLIENT_SECRET}
      pkce: true
      scopes: [openid, profile, email, offline_access]
